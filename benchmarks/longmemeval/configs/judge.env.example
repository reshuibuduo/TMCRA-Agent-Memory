# OpenAI-compatible Judge endpoint. The public runner selects the gpt-4o alias;
# the evaluator resolves it to the fixed gpt-4o-2024-08-06 model identifier.
TMCRA_JUDGE_BASE_URL=https://your-judge-endpoint.example/v1
TMCRA_JUDGE_API_KEY=replace_me
TMCRA_OFFICIAL_JUDGE_WORKERS=8

# The default wire format is POST /chat/completions. Uncomment this only when
# the configured endpoint implements POST /responses instead.
# OPENAI_WIRE_API=responses
