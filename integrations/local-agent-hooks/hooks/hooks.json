{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run_hook.mjs\" session-start codex",
            "timeout": 12,
            "statusMessage": "Checking local TMCRA memory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run_hook.mjs\" user-prompt codex",
            "timeout": 120,
            "statusMessage": "Recalling local TMCRA memory"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run_hook.mjs\" stop codex",
            "timeout": 120,
            "statusMessage": "Saving the completed turn locally"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/run_hook.mjs\" stop-failure codex",
            "timeout": 12,
            "statusMessage": "Closing the local memory turn"
          }
        ]
      }
    ]
  }
}
